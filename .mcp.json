{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server", "--connectionString", "${MONGODB_URI}"]
    },
    "uptimerobot": {
      "url": "https://mcp.uptimerobot.com/mcp"
    }
  }
}
